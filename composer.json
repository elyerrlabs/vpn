{
  "name": "elyerr/vpn",
  "version": "1.0.1",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "autoload": {
    "psr-4": {
      "Vpn\\App\\": "app/",
      "Vpn\\Database\\Factories\\": "database/factories/",
      "Vpn\\Database\\Seeders\\": "database/seeders/",
      "Vpn\\Tests\\": "tests/",
      "GPBMetadata\\": "GPBMetadata/",
      "Proto\\": "Proto/"
    },
    "files": [
      "app/Helpers/helper.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Vpn\\App\\Providers\\ServiceProvider"
      ]
    }
  },
  "require": {
    "grpc/grpc": "^1.74",
    "google/protobuf": "^4.33"
  },
  "require-dev": {
    "elyerr/laravel-runtime": "^1.0",
    "inertiajs/inertia-laravel": "^2.0",
    "elyerr/api-response": "^1.0",
    "laravel/framework": "^12.44"
  },
  "scripts": {
    "post-install-cmd": [
      "@php scripts/bootstrap_keys.php"
    ],
    "post-update-cmd": [
      "@php scripts/bootstrap_keys.php"
    ]
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
